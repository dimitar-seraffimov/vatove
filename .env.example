# Application
NODE_ENV=development
APP_TIMEZONE=Europe/London
PUBLIC_ORIGIN=http://localhost:8080
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Intervals.icu (copy to .env and set locally; never commit the real key)
INTERVALS_API_BASE_URL=https://intervals.icu
INTERVALS_API_KEY=
INTERVALS_USER_AGENT=Mozilla/5.0 (compatible; vatove/0.1; +http://localhost)
INTERVALS_REQUESTS_PER_SECOND=8

# PostgreSQL / PostGIS
POSTGRES_DB=vatove
POSTGRES_USER=vatove
POSTGRES_PASSWORD=vatove-local-only
DATABASE_URL=postgresql://vatove:vatove-local-only@postgis:5432/vatove

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_INGESTION_TOPIC=incoming_activities.v1
KAFKA_DLQ_TOPIC=incoming_activities.dlq.v1
KAFKA_CONSUMER_GROUP=vatove-intervals-worker-v1
